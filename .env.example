# Copy to .env and adjust before building (eas secret:set for CI builds).

# The site hosted inside the shell. Default: https://chat.z.ai
EXPO_PUBLIC_START_URL=https://chat.z.ai

# Remote config JSON (hot-patch channel). Host it yourself, e.g. on any static host.
# See remoteConfig.default.json + docs/remote-config.schema.json.
EXPO_PUBLIC_RC_URL=

# Crash reporting (optional). Without a DSN the app sends nothing anywhere.
EXPO_PUBLIC_SENTRY_DSN=
